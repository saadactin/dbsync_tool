# Copy this file to `.env` (in the same folder as manage.py) and fill in real values.
# DO NOT commit your real `.env` file.

# === Django ===
# Generate a fresh value with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<fill-with-random-secret>
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# === Database ===
# Leave DB_ENGINE empty to use SQLite. Set to `postgres` to use Postgres.
DB_ENGINE=
POSTGRES_DB=<db-name>
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<db-password>
POSTGRES_HOST=<db-host>
POSTGRES_PORT=5432

# === Encryption (Fernet, 44 char base64) ===
# Generate once and KEEP STABLE forever:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=<fill-with-fernet-key>

# === Email (SMTP for password reset / notifications) ===
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# For Gmail use smtp.gmail.com and an app-specific password on EMAIL_HOST_PASSWORD.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>
DEFAULT_FROM_EMAIL=<no-reply@example.com>
ADMIN_EMAILS=<admin@example.com>
# Recipient for scratch/test_network.py SMTP check only (not used by Django).
SMTP_TEST_TO_EMAIL=<recipient@example.com>

# === Site / runtime ===
SITE_URL=https://your-domain.example.com
SYNC_EXECUTION_STALE_TIMEOUT_MINUTES=30
# Absolute path on the server where flat-file (CSV) sources live. Empty = default to BASE_DIR/file_sources.
FILE_SYNC_ROOT=
FILE_SYNC_STRICT=True

# === Security (only honored when DEBUG=False) ===
SECURE_SSL_REDIRECT=True

# === Optional: Azure DevOps incremental sync via Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=dbsync
