# Superset Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User

# Superset Database (Postgres)
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=superset
SUPERSET_DB_NAME=superset
SUPERSET_DB_HOST=superset_db
SUPERSET_DB_PORT=5432

# Secret Key (CHANGE THIS in production!)
SUPERSET_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_IN_PRODUCTION

# Redis Cache
REDIS_HOST=superset_cache
REDIS_PORT=6379

# Path to Django SQLite database (relative to project root)
DJANGO_SQLITE_PATH=../dbsync_tool/db.sqlite3
